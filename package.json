{
  "name": "numbers-transition",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/numbers-transition.cjs",
  "module": "./dist/numbers-transition.js",
  "types": "./dist/numbers-transition.d.ts",
  "exports": {
    ".": {
      "types": "./dist/numbers-transition.d.ts",
      "import": "./dist/numbers-transition.js",
      "require": "./dist/numbers-transition.cjs"
    }
  },
  "scripts": {
    "prepare": "ts-patch install -s && husky",
    "lint": "eslint . --max-warnings 0",
    "build:plugins": "vite build -c vite.plugins.ts",
    "test:plugins": "tsc -p tsconfig.plugins.test.json && vitest -c vite.plugins.test.ts run",
    "verify:plugins": "npm run build:plugins && node plugins/dist/verify-dts tsconfig.plugins.json plugins/dist && npm run test:plugins",
    "storybook": "npm run build:plugins && storybook dev -p 6006",
    "build": "npm run verify:plugins && vite build",
    "verify": "npm run build && node plugins/dist/verify-dts tsconfig.json dist",
    "build:storybook": "npm run verify && storybook build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "styled-components": ">=6.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-storybook": "^10.5.10",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "storybook": "^10.5.10",
    "terser": "^5.51.2",
    "ts-patch": "^4.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-bundle-dts": "^0.5.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@microsoft/api-extractor": {
      "typescript": "$typescript"
    }
  }
}
